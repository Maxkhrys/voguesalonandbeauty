---
import Layout from '../layouts/Layout.astro';
import Fern from '../components/Fern.astro';
import Divider from '../components/Divider.astro';

const headline = 'Your hair, beautifully done.';
const words = headline.split(' ');

const services = [
  {
    title: 'Hair',
    description:
      'Cuts, colour, ombre, highlights, upstyles and extensions — crafted by stylists who listen first and cut second.',
    items: ['Cuts & styling', 'Colour & balayage', 'Upstyles & extensions'],
  },
  {
    title: 'Beauty & Nails',
    description:
      'Facials, waxing, HD brows, lash lifts and flawless shellac — everything you need to feel polished and put together.',
    items: ['Facials & waxing', 'HD brows & lashes', 'Manicure, pedicure & shellac'],
  },
  {
    title: 'Massage',
    description:
      'Switch off and unwind with relaxing full-body and back, neck & shoulder massage in our quiet treatment room.',
    items: ['Full body massage', 'Back, neck & shoulder', 'Pure relaxation'],
  },
];
---

<Layout title="Vogue Image Design — Hair & Beauty Salon, Wicklow Town">
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center overflow-hidden bg-forest text-ivory">
    <Fern
      class="botanical-sway pointer-events-none absolute -left-16 bottom-0 h-[34rem] w-auto text-sage opacity-10"
    />
    <Fern
      class="botanical-sway pointer-events-none absolute right-1/3 -top-24 hidden h-96 w-auto rotate-180 text-sage opacity-10 lg:block"
    />

    <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-6 pb-16 pt-32 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-sm uppercase tracking-[0.35em] text-gold">
          Hair · Beauty · Massage — Wicklow Town
        </p>
        <h1 class="mt-6 font-heading text-6xl font-light leading-[1.05] sm:text-7xl">
          {words.map((word) => <span class="hero-word mr-[0.28em]">{word}</span>)}
        </h1>
        <p class="hero-word mt-8 max-w-md text-lg leading-relaxed text-ivory/80">
          A warm, welcoming salon on Main Street where great hair days are made — seven days a
          week, no fuss, no waiting lists.
        </p>
        <div class="hero-word mt-10 flex flex-wrap gap-4">
          <a
            href="/booking"
            class="bg-gold px-8 py-4 text-sm uppercase tracking-[0.2em] text-charcoal transition-colors hover:bg-sage hover:text-ivory"
          >
            Book now
          </a>
          <a
            href="/services"
            class="border border-ivory/60 px-8 py-4 text-sm uppercase tracking-[0.2em] text-ivory transition-colors hover:border-gold hover:text-gold"
          >
            View services
          </a>
        </div>
      </div>

      <div class="relative hidden lg:block">
        <div class="absolute -inset-4 border border-sage/40"></div>
        <img
          src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=900&q=80"
          alt="Stylist working on a client's hair in the salon"
          class="relative aspect-[4/5] w-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Service preview cards -->
  <section class="bg-ivory py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="fade-up text-center">
        <p class="text-sm uppercase tracking-[0.35em] text-sage">What we do</p>
        <h2 class="mt-4 font-heading text-5xl font-light text-forest">
          One salon, every treatment
        </h2>
        <Divider class="mt-8 text-sage" />
      </div>

      <div class="stagger-cards mt-16 grid gap-8 md:grid-cols-3">
        {
          services.map((service) => (
            <article class="group flex flex-col border border-cream bg-white p-10 transition-shadow hover:shadow-xl hover:shadow-forest/10">
              <h3 class="font-heading text-3xl font-light text-forest">{service.title}</h3>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-charcoal/75">
                {service.description}
              </p>
              <ul class="mt-6 space-y-2 text-sm text-charcoal/80">
                {service.items.map((item) => (
                  <li class="flex items-center gap-3">
                    <span class="h-px w-5 bg-gold" />
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href="/services"
                class="mt-8 inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] text-gold transition-colors group-hover:text-forest"
              >
                See prices <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="bg-forest py-14 text-ivory">
    <div
      class="fade-up mx-auto flex max-w-6xl flex-col items-center justify-center gap-6 px-6 text-center sm:flex-row sm:gap-0"
    >
      {
        ['7 days a week', 'Walk-ins welcome', 'Main Street Wicklow'].map((item, i) => (
          <>
            {i > 0 && <span class="hidden px-10 text-gold sm:block">·</span>}
            <p class="font-heading text-2xl font-light tracking-wide">{item}</p>
          </>
        ))
      }
    </div>
  </section>

  <!-- Booking CTA banner -->
  <section class="relative overflow-hidden bg-cream py-24">
    <Fern
      class="botanical-sway pointer-events-none absolute -bottom-16 right-4 h-72 w-auto text-sage opacity-20"
    />
    <div class="fade-up relative mx-auto max-w-3xl px-6 text-center">
      <p class="text-sm uppercase tracking-[0.35em] text-sage">Ready when you are</p>
      <h2 class="mt-4 font-heading text-5xl font-light text-forest">
        Book your next appointment
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-charcoal/75">
        Reserve online in under a minute, or just drop in — we keep space for walk-ins every
        day. A 20% deposit confirms your booking.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="/booking"
          class="bg-gold px-8 py-4 text-sm uppercase tracking-[0.2em] text-charcoal transition-colors hover:bg-forest hover:text-ivory"
        >
          Book now
        </a>
        <a
          href="tel:+35340432790"
          class="border border-forest/40 px-8 py-4 text-sm uppercase tracking-[0.2em] text-forest transition-colors hover:border-gold hover:text-gold"
        >
          Call 0404 32 790
        </a>
      </div>
    </div>
  </section>
</Layout>
