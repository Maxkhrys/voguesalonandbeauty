---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const BOOKING_URL = 'https://salon67wicklow.book.app';

const services = [
  {
    title: 'Weft Extensions',
    copy: 'Seamless length and volume applied in discreet rows. The workhorse of transformations — full, flowing results that move naturally.',
    note: 'Lasts up to 2 years with correct aftercare',
    img: 'https://images.unsplash.com/photo-1522337660859-02fbefca4702?auto=format&fit=crop&w=1400&q=80',
    alt: 'Long hair being styled in a salon',
  },
  {
    title: 'Micro Bead Extensions',
    copy: 'Individual strands secured with tiny, discreet beads — no heat, no glue. A natural-looking finish that is gentle on your own hair.',
    note: 'Lasts up to 2 years with correct aftercare',
    img: 'https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&w=1400&q=80',
    alt: 'Hairdresser working through a client’s hair',
  },
  {
    title: 'Keratin Bond Extensions',
    copy: 'Versatile, long-lasting and beautifully discreet. Individual keratin bonds blend invisibly for total styling freedom — up or down.',
    note: 'Lasts up to 5 months',
    img: 'https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1400&q=80',
    alt: 'Elegant salon interior with styling chairs',
  },
  {
    title: 'Lived-in Blonde',
    copy: 'Our signature colour service. From seamless, rooted blends to vibrant pops of brightness — low-maintenance blonde that grows out as beautifully as it starts.',
    note: 'Signature colour service',
    img: 'https://images.unsplash.com/photo-1492106087820-71f1a00d2b11?auto=format&fit=crop&w=1400&q=80',
    alt: 'Woman with dimensional blonde colour',
  },
];

const faqs = [
  {
    q: 'How long do extensions last?',
    a: 'It varies by type — keratin bonds last up to 5 months, while weft and micro bead extensions can last up to 1–2 years with proper care and regular maintenance appointments.',
  },
  {
    q: 'Can I wash and style extensions like natural hair?',
    a: 'Yes. Your extensions can be washed, blow-dried and styled much like your own hair. We provide full aftercare guidance at your appointment so they stay looking their best.',
  },
  {
    q: 'What types of extensions do you offer?',
    a: 'We offer weft, micro bead and keratin bond extensions. Our experts will help you choose the method best suited to your hair type, lifestyle and the look you want.',
  },
];
---

<Layout
  title="Services — Salon 67"
  description="Weft, micro bead and keratin bond hair extensions plus our signature lived-in blonde colour service at Salon 67, Wicklow Town."
>
  <PageHeader
    eyebrow="Services"
    title="Specialty services"
    intro="Extensions and blonde colouring are not a sideline here — they are everything we do. Choose your method; we'll perfect the rest."
  />

  <section class="pb-24 lg:pb-36">
    <div class="mx-auto max-w-7xl space-y-20 px-6 lg:space-y-28 lg:px-10">
      {
        services.map((s, i) => (
          <article
            class={`fade-up grid items-center gap-10 lg:grid-cols-2 lg:gap-16 ${
              i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : ''
            }`}
          >
            <div class="overflow-hidden border border-silver/10">
              <img
                src={s.img}
                alt={s.alt}
                loading="lazy"
                class="img-luxe parallax-img aspect-[4/3] w-full object-cover"
              />
            </div>
            <div>
              <p class="font-display text-6xl font-light text-silver/20">
                0{i + 1}
              </p>
              <h2 class="font-display mt-2 text-3xl font-light tracking-tight text-pearl lg:text-4xl">
                {s.title}
              </h2>
              <p class="mt-5 max-w-md text-base leading-relaxed font-light text-platinum">
                {s.copy}
              </p>
              <p class="mt-6 inline-block border border-silver/25 px-4 py-2 text-[0.68rem] tracking-[0.24em] text-silver uppercase">
                {s.note}
              </p>
              <div class="mt-8">
                <a
                  href={BOOKING_URL}
                  target="_blank"
                  rel="noopener"
                  class="link-sweep text-[0.74rem] tracking-[0.28em] text-pearl uppercase"
                >
                  Book this service
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="bg-ink border-t border-silver/10 py-24 lg:py-32">
    <div class="mx-auto max-w-3xl px-6 lg:px-10">
      <p class="fade-up text-center text-[0.72rem] tracking-[0.32em] text-platinum uppercase">
        Good to know
      </p>
      <h2 class="fade-up font-display mt-5 text-center text-4xl font-light tracking-tight text-pearl lg:text-5xl">
        Questions, answered
      </h2>

      <div class="stagger-cards mt-14 divide-y divide-silver/10 border-y border-silver/10">
        {
          faqs.map((faq) => (
            <div class="faq-item">
              <button
                type="button"
                aria-expanded="false"
                class="flex w-full items-center justify-between gap-6 py-6 text-left"
              >
                <span class="font-display text-lg font-light text-pearl lg:text-xl">{faq.q}</span>
                <span class="faq-icon font-display shrink-0 text-2xl leading-none text-silver" aria-hidden="true">
                  +
                </span>
              </button>
              <div class="faq-answer">
                <div>
                  <p class="pb-7 text-sm leading-relaxed font-light text-platinum lg:text-base">
                    {faq.a}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="fade-up mt-14 text-center">
        <a
          href={BOOKING_URL}
          target="_blank"
          rel="noopener"
          class="bg-silver text-ink inline-block px-10 py-4 text-[0.78rem] tracking-[0.28em] uppercase transition-all duration-300 hover:bg-pearl"
        >
          Book your consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
