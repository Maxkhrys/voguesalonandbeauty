---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Contact & Find Us — Vogue Image Design, Wicklow Town">
  <PageHeader
    eyebrow="Contact"
    title="Come say hello"
    intro="Right on Main Street in the Up Mall — easy to find, easier to stay. Call, message or drop in any day of the week."
  />

  <section class="bg-ivory py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-14 lg:grid-cols-2">
        <div class="fade-up space-y-10">
          <div>
            <h2 class="text-sm uppercase tracking-[0.25em] text-sage">Address</h2>
            <address class="mt-4 font-heading text-2xl font-light not-italic leading-snug text-forest">
              Shop A, No. 20 Up Mall,<br />
              Main St, Wicklow Town,<br />
              Co. Wicklow
            </address>
          </div>

          <div>
            <h2 class="text-sm uppercase tracking-[0.25em] text-sage">Phone</h2>
            <a
              href="tel:+35340432790"
              class="mt-4 inline-block font-heading text-2xl font-light text-forest transition-colors hover:text-gold"
            >
              0404 32 790
            </a>
          </div>

          <div>
            <h2 class="text-sm uppercase tracking-[0.25em] text-sage">Opening hours</h2>
            <p class="mt-4 font-heading text-2xl font-light text-forest">
              Monday – Sunday, 9:30am – 6:00pm
            </p>
            <p class="mt-2 text-sm text-charcoal/65">
              Open 7 days a week · walk-ins welcome
            </p>
          </div>

          <div>
            <h2 class="text-sm uppercase tracking-[0.25em] text-sage">Social</h2>
            <a
              href="https://facebook.com/VogueHairAndBeautySalonWicklowTown"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-block text-forest underline decoration-gold underline-offset-4 transition-colors hover:text-gold"
            >
              facebook.com/VogueHairAndBeautySalonWicklowTown
            </a>
          </div>
        </div>

        <div class="fade-up">
          <iframe
            src="https://www.google.com/maps?q=Main+Street,+Wicklow+Town,+Co.+Wicklow,+Ireland&output=embed"
            title="Map showing Vogue Image Design on Main Street, Wicklow Town"
            class="h-full min-h-[24rem] w-full border border-cream"
            style="filter: grayscale(20%);"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>

      <div class="fade-up mt-20 border border-cream bg-white p-10 sm:p-14">
        <h2 class="font-heading text-3xl font-light text-forest">Send us a message</h2>
        <p class="mt-3 text-sm text-charcoal/70">
          For appointment requests the quickest option is the
          <a href="/booking" class="text-forest underline decoration-gold underline-offset-4">booking page</a>
          — for anything else, drop us a line below.
        </p>

        <form id="contact-form" class="mt-10 grid gap-6 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="text-charcoal/70">Your name</span>
            <input
              type="text"
              name="name"
              required
              class="mt-2 w-full border border-cream bg-ivory px-4 py-3 outline-none transition-colors focus:border-sage"
            />
          </label>
          <label class="block text-sm">
            <span class="text-charcoal/70">Phone or email</span>
            <input
              type="text"
              name="contact"
              required
              class="mt-2 w-full border border-cream bg-ivory px-4 py-3 outline-none transition-colors focus:border-sage"
            />
          </label>
          <label class="block text-sm sm:col-span-2">
            <span class="text-charcoal/70">Message</span>
            <textarea
              name="message"
              rows="5"
              required
              class="mt-2 w-full border border-cream bg-ivory px-4 py-3 outline-none transition-colors focus:border-sage"
            ></textarea>
          </label>
          <div class="sm:col-span-2">
            <button
              type="submit"
              class="bg-gold px-8 py-4 text-sm uppercase tracking-[0.2em] text-charcoal transition-colors hover:bg-forest hover:text-ivory"
            >
              Send message
            </button>
            <p class="mt-3 text-xs text-charcoal/50">
              Opens your email app — demo form, no details are stored.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Demo contact form: builds a mailto link from the fields.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const subject = encodeURIComponent(`Website enquiry from ${data.get('name')}`);
      const body = encodeURIComponent(
        `Name: ${data.get('name')}\nContact: ${data.get('contact')}\n\n${data.get('message')}`
      );
      window.location.href = `mailto:hello@vogueimagedesign.ie?subject=${subject}&body=${body}`;
    });
  </script>
</Layout>
