---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Rings from '../components/Rings.astro';

const BOOKING_URL = 'https://salon67wicklow.book.app';

const values = [
  {
    title: 'Personal attention',
    copy: 'As a small business, we pride ourselves on personal attention and dedication to every detail.',
  },
  {
    title: 'Quality & integrity',
    copy: 'Our approach is rooted in quality and integrity — in our products, our craft and our advice.',
  },
  {
    title: 'Confidence, always',
    copy: 'We ensure every client leaves feeling confident and beautiful — that is the whole point.',
  },
];
---

<Layout
  title="About — Salon 67"
  description="Salon 67 is Wicklow's premier destination for top-quality hair extension services. A small business built on passion, quality and integrity."
>
  <PageHeader
    eyebrow="About"
    title="A simple idea, fuelled by a deep passion"
  />

  <section class="pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="fade-up relative">
          <div class="overflow-hidden border border-silver/10">
            <img
              src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1400&q=80"
              alt="Elegant salon interior"
              loading="lazy"
              class="img-luxe parallax-img aspect-[4/5] w-full object-cover"
            />
          </div>
          <Rings class="absolute right-[-90px] bottom-[-90px] hidden h-72 w-72 lg:block" />
        </div>

        <div class="fade-up">
          <p class="font-display text-2xl leading-relaxed font-light text-pearl lg:text-3xl">
            It all began with a simple idea fuelled by a deep passion.
          </p>
          <p class="mt-7 text-base leading-relaxed font-light text-platinum">
            As a small business, we pride ourselves on personal attention and dedication to every
            detail. Our approach is rooted in quality and integrity.
          </p>
          <p class="mt-5 text-base leading-relaxed font-light text-platinum">
            Salon 67 is Wicklow's premier destination for top-quality hair extension services and
            outstanding tattoos. With a team of experienced professionals and a commitment to
            customer satisfaction, we ensure every client leaves feeling confident and beautiful.
          </p>
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener"
            class="bg-silver text-ink mt-10 inline-block px-10 py-4 text-[0.78rem] tracking-[0.28em] uppercase transition-all duration-300 hover:bg-pearl"
          >
            Book a visit
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink border-t border-silver/10 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="stagger-cards grid gap-12 md:grid-cols-3">
        {
          values.map((v, i) => (
            <div class="border-t border-silver/20 pt-8">
              <p class="font-display text-5xl font-light text-silver/25">0{i + 1}</p>
              <h2 class="font-display mt-4 text-2xl font-light text-pearl">{v.title}</h2>
              <p class="mt-4 text-sm leading-relaxed font-light text-platinum">{v.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
