---
const BOOKING_URL = 'https://salon67wicklow.book.app';
const LOGO_URL =
  'https://primary.jwwb.nl/public/n/b/v/temp-ntlbgehuitxuupijjhfo/img-20250130-wa0001-high-opm17x.jpg';

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const socials = [
  { href: 'https://facebook.com/share/1FgRcJDdt4', label: 'Facebook' },
  { href: 'https://instagram.com/salon67wicklow', label: 'Instagram' },
  { href: 'https://tiktok.com/@salon67wicklow', label: 'TikTok' },
];
---

<footer class="bg-ink border-t border-silver/10">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-20">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <img
            src={LOGO_URL}
            alt="Salon 67 logo"
            width="56"
            height="56"
            loading="lazy"
            class="h-14 w-14 rounded-full object-cover ring-1 ring-silver/25"
          />
          <span class="font-display text-xl tracking-[0.18em] text-pearl">SALON 67</span>
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed font-light text-platinum">
          Specialists in blonde colouring &amp; hair extensions — Wicklow Town.
        </p>
        <a
          href={BOOKING_URL}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block border border-silver/40 px-7 py-3 text-[0.72rem] tracking-[0.28em] text-pearl uppercase transition-all duration-300 hover:bg-silver hover:text-ink"
        >
          Book now
        </a>
      </div>

      <div>
        <h3 class="text-[0.72rem] tracking-[0.32em] text-silver uppercase">Quick links</h3>
        <ul class="mt-5 space-y-3">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-light text-platinum transition-colors hover:text-pearl"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-[0.72rem] tracking-[0.32em] text-silver uppercase">Visit us</h3>
        <address class="mt-5 text-sm leading-relaxed font-light text-platinum not-italic">
          Salon 67<br />
          Wicklow Town<br />
          A67 HD96
        </address>
        <p class="mt-4">
          <a
            href="tel:040466045"
            class="text-sm font-light text-platinum transition-colors hover:text-pearl"
          >
            0404 66 045
          </a>
        </p>
        <ul class="mt-6 flex gap-6">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="link-sweep text-[0.72rem] tracking-[0.22em] text-platinum uppercase transition-colors hover:text-pearl"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="hairline mt-14"></div>
    <p class="mt-8 text-center text-xs font-light tracking-[0.22em] text-platinum/70">
      © 2026 Salon 67
    </p>
  </div>
</footer>
