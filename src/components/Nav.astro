---
const BOOKING_URL = 'https://salon67wicklow.book.app';
const LOGO_URL =
  'https://primary.jwwb.nl/public/n/b/v/temp-ntlbgehuitxuupijjhfo/img-20250130-wa0001-high-opm17x.jpg';

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
    <a href="/" class="flex items-center gap-3" aria-label="Salon 67 — home">
      <img
        src={LOGO_URL}
        alt="Salon 67 logo"
        width="48"
        height="48"
        class="h-12 w-12 rounded-full object-cover ring-1 ring-silver/30"
      />
      <span class="font-display text-lg tracking-[0.18em] text-pearl">SALON 67</span>
    </a>

    <ul class="hidden items-center gap-9 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? 'page' : undefined}
              class="link-sweep text-[0.8rem] font-light tracking-[0.22em] text-silver uppercase transition-colors hover:text-pearl"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener"
        class="hidden border border-silver/50 px-6 py-2.5 text-[0.75rem] tracking-[0.28em] text-pearl uppercase transition-all duration-300 hover:border-silver hover:bg-silver hover:text-ink sm:inline-block"
      >
        Book now
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="relative z-50 flex h-11 w-11 flex-col items-center justify-center gap-1.5 lg:hidden"
      >
        <span class="block h-px w-6 bg-pearl"></span>
        <span class="block h-px w-6 bg-pearl"></span>
        <span class="block h-px w-6 bg-pearl"></span>
      </button>
    </div>
  </nav>
</header>

<!-- Fullscreen dark overlay menu (mobile) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-2 bg-ink/97 backdrop-blur-xl lg:hidden"
>
  {
    links.map((link, i) => (
      <a
        href={link.href}
        class="font-display py-3 text-3xl font-light tracking-wide text-pearl transition-colors hover:text-silver"
        style={`transition-delay: ${i * 40}ms`}
      >
        {link.label}
      </a>
    ))
  }
  <a
    href={BOOKING_URL}
    target="_blank"
    rel="noopener"
    class="mt-8 border border-silver/50 px-10 py-3.5 text-[0.8rem] tracking-[0.28em] text-pearl uppercase"
  >
    Book now
  </a>
  <p class="mt-10 text-sm font-light tracking-widest text-platinum">
    <a href="tel:040466045">0404 66 045</a>
  </p>
</div>
