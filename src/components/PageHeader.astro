---
import Rings from './Rings.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden pt-44 pb-20 lg:pt-56 lg:pb-28">
  <Rings class="absolute top-[-260px] right-[-220px] h-[620px] w-[620px] opacity-70" />
  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <p class="fade-up text-[0.72rem] tracking-[0.32em] text-platinum uppercase">{eyebrow}</p>
    <h1 class="fade-up font-display mt-5 max-w-3xl text-5xl font-light tracking-tight text-pearl lg:text-7xl">
      {title}
    </h1>
    {
      intro && (
        <p class="fade-up mt-7 max-w-xl text-base leading-relaxed font-light text-silver/90 lg:text-lg">
          {intro}
        </p>
      )
    }
  </div>
</section>
