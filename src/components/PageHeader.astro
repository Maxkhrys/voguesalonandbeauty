---
import Fern from './Fern.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-forest pb-20 pt-36 text-ivory">
  <Fern
    class="botanical-sway pointer-events-none absolute -right-10 -top-12 h-80 w-auto text-sage opacity-15"
  />
  <div class="relative mx-auto max-w-6xl px-6">
    <p class="text-sm uppercase tracking-[0.35em] text-gold">{eyebrow}</p>
    <h1 class="mt-4 font-heading text-5xl font-light sm:text-6xl">{title}</h1>
    {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ivory/80">{intro}</p>}
  </div>
</section>
